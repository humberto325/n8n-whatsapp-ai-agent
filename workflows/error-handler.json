{
  "name": "WhatsApp Agent - Error Handler",
  "nodes": [
    {
      "parameters": {
        "content": "## Error handler\nSet this workflow as **Settings -> Error workflow** on the main agent and the handoff workflow. Any unhandled failure posts to Slack with a link to the execution.",
        "width": 520,
        "height": 180,
        "color": 7
      },
      "id": "38ba6f6c-b865-4877-a296-37d1301894cf",
      "name": "Note: Errors",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -320,
        -240
      ]
    },
    {
      "parameters": {},
      "id": "a294cb29-e3ce-4283-a039-5d13b0137e84",
      "name": "On Workflow Error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        -240,
        40
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "automation-alerts"
        },
        "messageType": "text",
        "text": "=:rotating_light: *n8n workflow failed*: {{ $json.workflow.name }}\n*Node:* {{ $json.execution.lastNodeExecuted || 'n/a' }}\n*Error:* {{ $json.execution.error?.message || $json.trigger?.error?.message || 'unknown' }}\n*Execution:* {{ $json.execution.url || 'n/a' }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "id": "e571a080-5e3e-46c8-ac64-92eb6d4d972f",
      "name": "Alert Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.7,
      "position": [
        0,
        40
      ],
      "credentials": {
        "slackApi": {
          "id": "REPLACE_WITH_SLACKAPI_ID",
          "name": "Slack account"
        }
      }
    }
  ],
  "pinData": {},
  "connections": {
    "On Workflow Error": {
      "main": [
        [
          {
            "node": "Alert Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/New_York",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
